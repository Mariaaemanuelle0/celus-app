# Copie para .env e preencha. Nunca suba o .env para o GitHub.

# Supabase (Settings > API no painel do projeto)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Mapa. Vazio = OpenStreetMap (só para desenvolvimento).
# Produção: URL de tiles do Mapbox com o seu token.
VITE_MAP_TILE_URL=
VITE_MAP_ATTRIBUTION=

# Centro da cidade piloto (lat,lng). Vazio = São Paulo.
VITE_PILOT_CENTER=
