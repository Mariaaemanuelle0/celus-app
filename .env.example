# Copie para .env e preencha. Nunca suba o .env para o GitHub.

# Supabase (Settings > API no painel do projeto)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Mapa. Vazio = estilo próprio da Celus com dados do OpenStreetMap via OpenFreeMap (gratuito, sem chave).
# Para usar Mapbox no futuro: URL do estilo com o token, ex.: https://api.mapbox.com/styles/v1/USUARIO/ESTILO?access_token=...
VITE_MAP_STYLE_URL=

# Centro da cidade piloto (lat,lng). Vazio = São Paulo.
VITE_PILOT_CENTER=
